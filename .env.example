# Postgres connection string
DATABASE_URL=postgres://localhost:5432/wave_analytics

# Session cookie signing secret (any long random string)
SESSION_SECRET=change-me

# Shared password producers use to log in
APP_PASSWORD=change-me

# Port for the Express server
PORT=4000

# BigQuery (only needed to run the live sync — CSV seeding works without these)
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=
BIGQUERY_TABLE=
# Path to a service account JSON key file (local dev), OR inline JSON (Render secret)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# YouTube Data API v3 key, used only by `npm run youtube:backfill` to look up
# thumbnails by exact title match
YOUTUBE_API_KEY=
# Optional: cap how many lookups one backfill run performs (default 90,
# staying under the default 10,000-unit/day quota at 100 units/search)
YOUTUBE_LOOKUP_BATCH_SIZE=90
